[Unit]
Description=Encrypted SQLite snapshot for Website Workspace
After=website-workspace.service

[Service]
Type=oneshot
User=website-workspace
Group=website-workspace
WorkingDirectory=/opt/website-workspace
EnvironmentFile=/etc/website-workspace.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/flock -w 240 /var/lib/website-workspace/maintenance.lock /opt/website-workspace/.venv/bin/python scripts/backup.py create
UMask=0077
MemoryMax=128M
CPUQuota=25%
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=600
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/website-workspace
