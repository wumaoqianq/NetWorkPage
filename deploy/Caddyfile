# Replace workspace.example.com with the real DNS name before starting Caddy.
workspace.example.com {
    encode zstd gzip
    request_body {
        max_size 5MB
    }
    @backend path /api/* /downloads/*
    handle @backend {
        reverse_proxy 127.0.0.1:8000
    }
    handle {
        root * /opt/website-workspace/prototype/dist/client
        try_files {path} /index.html
        file_server
    }
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy same-origin
        X-Frame-Options DENY
    }
}
